# Copy to .env and fill in the values. .env is ignored by git.

# npm run test:live
DEEPSEEK_API_KEY=

# npm run test:live:forge and npm run test:live:forgejo (a local Forgejo or Gitea with the repository seeded)
# FORGEJO_TOKEN is the repository owner's access token; FORGEJO_CONTRIBUTOR_TOKEN is another user's.
# FORGEJO_URL=http://localhost:3000
# FORGEJO_REPO=eka/notes
FORGEJO_TOKEN=
FORGEJO_CONTRIBUTOR_TOKEN=
