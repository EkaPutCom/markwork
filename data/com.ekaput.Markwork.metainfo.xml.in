<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.ekaput.Markwork</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Markwork</name>
  <summary>Personal workbench for humans and AI agents</summary>
  <description>
    <p>
      Markwork is a personal workspace for notes, documents, research, plans, and tasks
      alongside AI agents that understand the context of your work.
    </p>
    <ul>
      <li>Markdown editor with live formatted view, tables, images, and Mermaid diagrams</li>
      <li>Kanban boards from Markdown files</li>
      <li>Per-file Git history</li>
      <li>AI assistant that proposes changes for you to review before they are applied</li>
    </ul>
  </description>
  <developer id="com.ekaput">
    <name>Eka Putra</name>
  </developer>
  <launchable type="desktop-id">com.ekaput.Markwork.desktop</launchable>
  <url type="homepage">https://nyerat.ekaput.com/</url>
  <url type="help">https://nyerat.ekaput.com/docs/</url>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <recommends>
    <internet>always</internet>
  </recommends>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <caption>Editor with the assistant</caption>
      <image>https://nyerat.ekaput.com/assets/assistant-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Kanban board</caption>
      <image>https://nyerat.ekaput.com/assets/kanban.png</image>
    </screenshot>
    <screenshot>
      <caption>Editor in dark mode</caption>
      <image>https://nyerat.ekaput.com/assets/editor-dark.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="1.0" date="2026-10-06"/>
  </releases>
</component>
