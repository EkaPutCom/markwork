{
    "id": "com.ekaput.Markwork",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.node22"],
    "command": "markwork",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--share=network",
        "--filesystem=home",
        "--talk-name=org.freedesktop.secrets"
    ],
    "cleanup": ["/include", "/lib/pkgconfig", "*.la", "*.a"],
    "modules": [
        {
            "name": "markwork",
            "buildsystem": "simple",
            "build-options": {
                "append-path": "/usr/lib/sdk/node22/bin",
                "build-args": ["--share=network"],
                "env": { "npm_config_cache": "/run/build/markwork/npm-cache" }
            },
            "build-commands": [
                "npm ci",
                "npm run build",
                "meson setup _build --prefix=/app",
                "meson install -C _build"
            ],
            "sources": [
                { "type": "dir", "path": "../.." }
            ]
        }
    ]
}
