[Unit]
Description=Markwork agent supervisor
Requires=markworkd.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/markworkd serve
Restart=on-failure
# Each agent lives under its own shim (docs/design/markworkd.md, section 17) so it survives a stop or restart of
# this service: do not let systemd kill the whole control group.
KillMode=process
# SIGTERM detaches the daemon from its runs; with "shims": false it stops them in an orderly way, which takes time.
TimeoutStopSec=20
