{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true
  },
  "include": ["src", "tests"],
  "exclude": ["src/platform/node", "tests/core/host-node.ts", "tests/core/run-core-node.ts", "tests/unit/nodeplatform.ts", "tests/unit/crossos.ts", "tests/live", "tests/bench"]
}
