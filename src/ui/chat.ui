<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MarkworkChatPanel" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="width-request">360</property>
    <style>
      <class name="sidebar"/>
      <class name="chat"/>
    </style>

    <!-- Title and buttons: new conversation, agent log, history, settings -->
    <child>
      <object class="GtkBox">
        <property name="margin-top">4</property>
        <property name="margin-bottom">8</property>
        <property name="margin-end">6</property>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">ASSISTANT</property>
            <property name="xalign">0</property>
            <property name="margin-start">16</property>
            <property name="hexpand">true</property>
            <style>
              <class name="side-title"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="clearButton">
            <property name="icon-name">edit-clear-all-symbolic</property>
            <property name="has-frame">false</property>
            <property name="tooltip-text" translatable="yes">New conversation</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="logButton">
            <property name="icon-name">utilities-terminal-symbolic</property>
            <property name="has-frame">false</property>
            <property name="tooltip-text" translatable="yes">Agent log: reasoning, the tools used, and their results</property>
          </object>
        </child>
        <child>
          <object class="GtkMenuButton" id="historyButton">
            <property name="icon-name">document-open-recent-symbolic</property>
            <property name="has-frame">false</property>
            <property name="tooltip-text" translatable="yes">Previous conversations</property>
            <property name="popover">
              <object class="GtkPopover" id="historyPopover">
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="width-request">320</property>
                    <style>
                      <class name="chat-pop"/>
                    </style>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Previous conversations</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="side-title"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="min-content-width">300</property>
                        <property name="max-content-height">280</property>
                        <property name="propagate-natural-height">true</property>
                        <child>
                          <object class="GtkBox" id="chatList">
                            <property name="orientation">vertical</property>
                            <property name="spacing">2</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkMenuButton" id="settingsButton">
            <property name="icon-name">emblem-system-symbolic</property>
            <property name="has-frame">false</property>
            <property name="tooltip-text" translatable="yes">Assistant settings</property>
            <property name="popover">
              <object class="GtkPopover" id="settingsPopover">
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <style>
                      <class name="chat-pop"/>
                    </style>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">DeepSeek API key</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="side-title"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkEntry" id="keyEntry">
                            <property name="visibility">false</property>
                            <property name="placeholder-text" translatable="yes">sk-…</property>
                            <property name="width-chars">28</property>
                            <property name="input-purpose">password</property>
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="saveKeyButton">
                            <property name="label" translatable="yes">Save</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="forgetKeyButton">
                            <property name="label" translatable="yes">Delete</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="keyStatus">
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">36</property>
                        <style>
                          <class name="side-meta"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Model</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="side-title"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="modelDrop"/>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="thinkingCheck">
                        <property name="label" translatable="yes">Deep thinking</property>
                        <property name="tooltip-text" translatable="yes">The model reasons for longer before answering: usually more thorough, but slower and more expensive</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="saveCheck">
                        <property name="label" translatable="yes">Save conversation history in the folder</property>
                        <property name="tooltip-text" translatable="yes">Each conversation is written as a Markdown file in &lt;work folder&gt;/.markwork/chats. It contains document quotes; the .markwork folder is not included in Git unless you delete .markwork/.gitignore</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Documents included as context (set through the Context button) are sent to the DeepSeek server every time you ask a question.</property>
                        <property name="xalign">0</property>
                        <property name="wrap">true</property>
                        <property name="max-width-chars">36</property>
                        <style>
                          <class name="side-meta"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>

    <!-- Messages. EXTERNAL, not NEVER: NEVER passes the natural width of the contents (long text without spaces) up to the parent and widens the panel. -->
    <child>
      <object class="GtkScrolledWindow" id="scroller">
        <property name="hscrollbar-policy">external</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkBox" id="messages">
            <property name="orientation">vertical</property>
            <property name="spacing">10</property>
            <property name="margin-bottom">12</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">4</property>
          </object>
        </child>
      </object>
    </child>

    <!-- Context: a summary, and a popover to set what is sent -->
    <child>
      <object class="GtkMenuButton" id="contextButton">
        <property name="label" translatable="yes">Context</property>
        <property name="has-frame">false</property>
        <property name="direction">up</property>
        <property name="halign">start</property>
        <property name="margin-start">8</property>
        <property name="popover">
          <object class="GtkPopover" id="contextPopover">
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <style>
                  <class name="chat-pop"/>
                </style>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">What is sent to the model</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="side-title"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="contextDocument">
                    <property name="label" translatable="yes">The currently open document</property>
                    <property name="tooltip-text" translatable="yes">The full contents of the active document (if too long: the part around the cursor)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="contextSelection">
                    <property name="label" translatable="yes">Selected text</property>
                    <property name="tooltip-text" translatable="yes">The sentence currently highlighted in the editor</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="contextProject">
                    <property name="label" translatable="yes">Other files in the folder</property>
                    <property name="tooltip-text" translatable="yes">The project map, relevant excerpts, @mentioned files, and permission for the assistant to search and read documents by itself</property>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator"/>
                </child>
                <child>
                  <object class="GtkBox" id="contextList">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Optional: type @filename in the message to attach a whole file directly. The assistant can also search and read other files by itself.</property>
                    <property name="xalign">0</property>
                    <property name="wrap">true</property>
                    <property name="max-width-chars">36</property>
                    <style>
                      <class name="side-meta"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>

    <!-- Input -->
    <child>
      <object class="GtkBox">
        <property name="margin-bottom">8</property>
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <property name="margin-top">2</property>
        <!-- The send button is inside the message box: one frame for the text and the button. -->
        <property name="overflow">hidden</property>
        <style>
          <class name="chat-composer"/>
        </style>
        <child>
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">external</property>
            <property name="min-content-height">64</property>
            <property name="max-content-height">160</property>
            <property name="propagate-natural-height">true</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkTextView" id="input">
                <property name="wrap-mode">word-char</property>
                <property name="top-margin">6</property>
                <property name="bottom-margin">6</property>
                <property name="left-margin">8</property>
                <property name="right-margin">8</property>
                <style>
                  <class name="chat-input"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="sendButton">
            <property name="icon-name">go-up-symbolic</property>
            <property name="tooltip-text" translatable="yes">Send (Enter)</property>
            <property name="valign">end</property>
            <property name="margin-end">6</property>
            <property name="margin-bottom">6</property>
            <style>
              <class name="circular"/>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
