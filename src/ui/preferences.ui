<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MarkworkPreferencesDialog" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferences</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">preferences-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">View</property>
            <child>
              <object class="AdwComboRow" id="colorScheme">
                <property name="title" translatable="yes">Color scheme</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">Follow system</item>
                      <item translatable="yes">Light</item>
                      <item translatable="yes">Dark</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="focus">
                <property name="title" translatable="yes">Focus mode</property>
                <property name="subtitle" translatable="yes">Dim all paragraphs except the one being edited</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="typewriter">
                <property name="title" translatable="yes">Typewriter mode</property>
                <property name="subtitle" translatable="yes">Keep the line being typed in the middle</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Files</property>
            <child>
              <object class="AdwSwitchRow" id="home">
                <property name="title" translatable="yes">Home</property>
                <property name="subtitle" translatable="yes">Show when no document is open</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="autosave">
                <property name="title" translatable="yes">Autosave</property>
                <property name="subtitle" translatable="yes">Applies to documents that already have a file</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Collaboration</property>
            <property name="description" translatable="yes">Pull requests of the Forgejo or Gitea server behind the folder's git remote</property>
            <child>
              <object class="AdwSpinRow" id="forgePoll">
                <property name="title" translatable="yes">Check every</property>
                <property name="subtitle" translatable="yes">Seconds between looks for new pull requests</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">30</property>
                    <property name="upper">3600</property>
                    <property name="step-increment">30</property>
                    <property name="page-increment">300</property>
                    <property name="value">60</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="forgeNotify">
                <property name="title" translatable="yes">Desktop notifications</property>
                <property name="subtitle" translatable="yes">When a pull request is opened or updated</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Assistant</property>
        <property name="icon-name">user-available-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwComboRow" id="chatModel">
                <property name="title" translatable="yes">Model</property>
                <property name="model">
                  <object class="GtkStringList" id="chatModels"/>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="chatThinking">
                <property name="title" translatable="yes">Thinking mode</property>
                <property name="subtitle" translatable="yes">More thorough, but slower</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="chatSave">
                <property name="title" translatable="yes">Save conversation history</property>
                <property name="subtitle" translatable="yes">Saved in the work folder, in .markwork/chats</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="agentsPage">
        <property name="title" translatable="yes">Agents</property>
        <property name="icon-name">system-run-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Where agents run</property>
            <property name="description" translatable="yes">The agents that work on kanban cards. On markworkd they keep working when Markwork is closed.</property>
            <child>
              <object class="AdwComboRow" id="harnessMachine">
                <property name="title" translatable="yes">Run agents</property>
                <property name="model">
                  <object class="GtkStringList" id="harnessMachines"/>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="daemonCommand">
                <property name="title" translatable="yes">markworkd command on other machines</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="machinesGroup">
            <property name="title" translatable="yes">Machines</property>
            <property name="description" translatable="yes">Computers that run agents through ssh and markworkd</property>
            <property name="header-suffix">
              <object class="GtkButton" id="addMachine">
                <property name="label" translatable="yes">Add Machine…</property>
                <property name="valign">center</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
