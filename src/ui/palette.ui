<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MarkworkCommandPalette" parent="AdwDialog">
    <property name="title" translatable="yes">Command Palette</property>
    <property name="content-width">520</property>
    <property name="content-height">420</property>
    <property name="focus-widget">search</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="GtkSearchEntry" id="search">
            <property name="placeholder-text" translatable="yes">Type a command…</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">6</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
          </object>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <child>
              <object class="GtkListView" id="list">
                <property name="single-click-activate">true</property>
                <style>
                  <class name="navigation-sidebar"/>
                </style>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
